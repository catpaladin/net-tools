{
  "release-please": {
    "release-type": "go",
    "package-name": "net-tools",
    "changelog-sections": [
      {
        "type": "feat",
        "section": "Features",
        "hidden": false
      },
      {
        "type": "fix",
        "section": "Bug Fixes",
        "hidden": false
      },
      {
        "type": "docs",
        "section": "Documentation",
        "hidden": false
      },
      {
        "type": "style",
        "section": "Style",
        "hidden": false
      },
      {
        "type": "refactor",
        "section": "Refactoring",
        "hidden": false
      },
      {
        "type": "perf",
        "section": "Performance",
        "hidden": false
      },
      {
        "type": "test",
        "section": "Tests",
        "hidden": false
      },
      {
        "type": "build",
        "section": "Build",
        "hidden": false
      },
      {
        "type": "ci",
        "section": "CI",
        "hidden": false
      },
      {
        "type": "chore",
        "section": "Chore",
        "hidden": true
      }
    ],
    "commit-parse": {
      "header-pattern": "^(?:\\[(?<scope>.+)\\]\\s*)?(?<type>\\w+)(?:\\((?<subtype>.+)\\))?!?:\\s*(?<subject>.+)$",
      "header-correspondence": [
        "type",
        "scope",
        "subject"
      ],
      "note-keywords": [
        "BREAKING CHANGE"
      ]
    }
  }
}